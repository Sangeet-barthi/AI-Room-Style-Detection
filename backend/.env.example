# ---------------------------------------------------------------------------
# RoomStyle AI — copy to .env and fill in. NEVER commit the real .env file.
# Nothing in this file is exposed to the browser: the frontend only ever
# receives the non-secret values returned by GET /capabilities.
# ---------------------------------------------------------------------------

# ---- Application ----
APP_ENV=development
APP_NAME=RoomStyleAI
DEBUG=true

# ---- Database ----
# Docker Compose builds this automatically from the POSTGRES_* values below.
# For local development without Docker, point at your own PostgreSQL instance,
# or use SQLite: sqlite+aiosqlite:///./roomai.db
DATABASE_URL=postgresql+asyncpg://app:app_password@db:5432/roomai

POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=roomai
POSTGRES_PORT=5432

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- CORS ----
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ---- Vision model (required for new analyses) ----
# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6JUBEqKCgtVocK8ORo5rQ0OkVoH7DIUSMMZuonYPjZPqA
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=90

# ---- Optional AI image generation ----
# Entirely optional. With this disabled the app shows the deterministic
# design mockup instead, and analysis is unaffected.
IMAGE_GENERATION_PROVIDER=pixazo
PIXAZO_IMAGE_PROVIDER_ENABLED=false
PIXAZO_API_KEY=e25e693b839a487582ea3f37003a2041
PIXAZO_BASE_URL=https://api.pixazo.com/v1
PIXAZO_MODEL=flux-schnell-free
PIXAZO_TIMEOUT_SECONDS=120

# ---- Uploads and storage ----
MAX_UPLOAD_MB=10
MIN_IMAGE_DIMENSION=200
MAX_IMAGE_DIMENSION=6000
UPLOAD_DIR=./storage_data/uploads
REPORT_DIR=./storage_data/reports
GENERATED_DIR=./storage_data/generated

# ---- Room-health score weights (must describe your intended balance) ----
SCORE_WEIGHT_LIGHTING=0.35
SCORE_WEIGHT_VENTILATION=0.25
SCORE_WEIGHT_SPACE=0.40

# ---- Rate limiting (requests/seconds) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_ANALYSIS=12/3600
RATE_LIMIT_MAKEOVER=8/3600
RATE_LIMIT_REPORT=20/3600

# ---- Demo mode (development only) ----
DEMO_MODE=false
DEMO_USER_EMAIL=demo@roomstyle.ai
DEMO_USER_PASSWORD=
SEED_ON_START=false

# ---- Docker port mapping ----
BACKEND_PORT=8000
FRONTEND_PORT=3000
